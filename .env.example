# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE — HOSTINGER VPS PRODUCTION
# Target Public Domain: https://asset.nkbmanufacturing.com
# Project Name: nkb-unified-assets
# NOTE: Replace all placeholder values before launching in production.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# Canonical Relational Database Configuration
# Uses container-internal SQLite database stored on persistent volume
DB_CLIENT=sqlite3
DB_FILE=/app/backend/data/nkb_unified.sqlite

# Security & Cryptographic Tokens
# Generate 64-char random hex strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_key
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_64_character_hex_secret_key
JWT_ACCESS_EXPIRY=8h
JWT_REFRESH_EXPIRY=7d

# Initial Super Admin Seed Credentials (Applied only on initial clean migration)
INITIAL_SUPER_ADMIN_USERNAME=admin
INITIAL_SUPER_ADMIN_EMAIL=admin@nkbmanufacturing.com
INITIAL_SUPER_ADMIN_PASSWORD=replace_with_a_strong_production_admin_password
INITIAL_SUPER_ADMIN_NAME=System Administrator

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Application URL & CORS (Restricted to production domain)
APP_URL=https://asset.nkbmanufacturing.com
CORS_ALLOWED_ORIGINS=https://asset.nkbmanufacturing.com

# Logging Level: error, warn, info, debug
LOG_LEVEL=info
