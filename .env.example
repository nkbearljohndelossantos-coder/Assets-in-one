# ==============================================================================
# NKB UNIFIED ITMS + PPE SYSTEM CONFIGURATION TEMPLATE
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# Canonical Relational Database Configuration
# Supported drivers: 'sqlite3' (recommended for single-server/standalone) or 'mysql2' (enterprise cluster)
DB_CLIENT=sqlite3
DB_FILE=./data/nkb_unified.sqlite

# Enterprise MySQL / MariaDB Settings (When DB_CLIENT=mysql2)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nkb_user
DB_PASSWORD=your_secure_db_password_here
DB_DATABASE=nkb_unified_db

# Security & Cryptographic Tokens
# Generate 64-character hex strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_key
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_64_character_hex_secret_key
JWT_ACCESS_EXPIRY=8h
JWT_REFRESH_EXPIRY=7d

# Initial Super Admin Seed Credentials (used only on first clean installation)
INITIAL_SUPER_ADMIN_USERNAME=admin
INITIAL_SUPER_ADMIN_EMAIL=admin@nkbmanufacturing.com
INITIAL_SUPER_ADMIN_PASSWORD=replace_with_strong_initial_admin_password
INITIAL_SUPER_ADMIN_NAME=System Administrator

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Application URL & CORS (comma-separated origins)
APP_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5000

# Logging Level: error, warn, info, http, verbose, debug
LOG_LEVEL=info
